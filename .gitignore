# Python dependencies and caches
.venv/
__pycache__/
*.py[cod]
.mypy_cache/
.ruff_cache/
.pytest_cache/
*.egg-info/

# Build outputs (anchored: unanchored build/ used to swallow hand-written
# verification scripts under desktop/build/)
/dist/
/build/
/desktop/build/
/releases/

# Local environment settings (keep shareable examples)
.env
.env.*
!.env.example

# Application data and logs
*.sqlite
*.sqlite3
*.sqlite-wal
*.sqlite-shm
*.sqlite3-wal
*.sqlite3-shm
*.db
*.db-wal
*.db-shm
/data/
*.log

# OS metadata
.DS_Store
Thumbs.db
Desktop.ini

# Desktop dependencies and generated files
desktop/node_modules/
desktop/src-tauri/target/
desktop/src-tauri/runtime/
/desktop/src-tauri/gen/schemas/

# Android build and sync artifacts
android/.gradle/
android/local.properties
android/**/build/
android/app/src/main/python/server/
android/app/src/main/python/web/
android/app/src/main/python/configs/
android/app/src/main/python/alembic.ini
android/scripts/.tooling-venv/
