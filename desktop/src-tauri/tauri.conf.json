{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "有得看",
  "version": "0.1.1",
  "identifier": "com.youdekan.reader",
  "build": {
    "beforeDevCommand": "../.venv/bin/python scripts/build_backend.py",
    "beforeBuildCommand": "../.venv/bin/python scripts/build_backend.py",
    "frontendDist": "../launcher"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "有得看",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "Utility",
    "shortDescription": "本地内容聚合阅读器",
    "longDescription": "有得看是一个本地内容聚合阅读器。",
    "resources": {"runtime/youdekan-backend/": "backend/"},
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    }
  }
}
